exports[`organised messages — shared layout > e-mail HTML snapshot (AR, right-to-left, digest) 1`] = `"<html lang="ar" dir="rtl"><head><meta charSet="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="color-scheme" content="light dark"/><meta name="supported-color-schemes" content="light dark"/></head><body style="margin:0;padding:24px 12px;background-color:#ffffff;font-family:Arial,Helvetica,sans-serif;color:#0f172a"><div style="display:none;max-height:0;overflow:hidden;opacity:0">لديك 2 رسائل جديدة من الفريق</div><div style="max-width:600px;width:100%;margin:0 auto;border:1px solid #e2e8f0;border-radius:16px;background-color:#ffffff;overflow:hidden;direction:rtl;text-align:right"><div style="padding:20px 24px;border-bottom:1px solid #e2e8f0;background-color:#ffffff"><img src="https://www.aisupport360.com/__l5e/assets-v1/94a9cd20-ec56-41c9-897e-534889a80659/brand-navy.png" width="180" height="40" alt="AI Support 360" style="display:block;border:0;width:180px;height:40px;max-width:100%"/></div><div style="padding:24px"><h1 style="font-size:22px;line-height:1.3;color:#1B2559;margin:14px 0 6px">لديك 2 رسائل جديدة من الفريق</h1><div style="margin:0 0 12px;padding:14px 16px;border-radius:12px;border:1px solid #e2e8f0"><span style="display:inline-block;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:bold;letter-spacing:0.02em;color:#92400E;background-color:#FEF3C7">مطلوب إجراء</span><p style="font-size:15px;font-weight:bold;color:#1B2559;margin:10px 0 4px">Title 0</p><p style="font-size:15px;line-height:1.65;color:#334155;margin:0 0 8px">Two quick changes and your profile can be verified.</p><p style="font-size:13px;color:#475569;margin:0 0 8px;font-weight:bold">الموعد النهائي: الجمعة، ٦ نوفمبر ٢٠٢٦</p><a href="https://www.aisupport360.com/consultant/profile" style="color:#2563EB;text-decoration:underline">فتح</a></div><div style="margin:0 0 12px;padding:14px 16px;border-radius:12px;border:1px solid #e2e8f0"><span style="display:inline-block;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:bold;letter-spacing:0.02em;color:#92400E;background-color:#FEF3C7">مطلوب إجراء</span><p style="font-size:15px;font-weight:bold;color:#1B2559;margin:10px 0 4px">Title 1</p><p style="font-size:15px;line-height:1.65;color:#334155;margin:0 0 8px">Two quick changes and your profile can be verified.</p><p style="font-size:13px;color:#475569;margin:0 0 8px;font-weight:bold">الموعد النهائي: الجمعة، ٦ نوفمبر ٢٠٢٦</p><a href="https://www.aisupport360.com/consultant/profile" style="color:#2563EB;text-decoration:underline">فتح</a></div><div style="margin:22px 0 10px"><a href="https://www.aisupport360.com/notifications" style="display:inline-block;background-color:#1B2559;color:#ffffff;padding:14px 28px;border-radius:12px;font-size:16px;font-weight:bold;text-decoration:none">الرد عبر البوابة</a></div><p style="font-size:12px;color:#64748b;margin:18px 0 0;border-top:1px solid #e2e8f0;padding-top:14px">أرسلها فريق AI Support 360 (المسؤول) · ٣٠ أكتوبر ٢٠٢٦، ١٢:٤٠ م UTC</p></div><div style="padding:16px 24px 22px;background-color:#f8fafc;border-top:1px solid #e2e8f0"><p style="font-size:12px;line-height:1.55;color:#64748b;margin:0 0 6px">للرد، افتح البوابة من الزر أعلاه. لا تتم قراءة الردود على هذا البريد.</p><p style="font-size:12px;line-height:1.55;color:#64748b;margin:0 0 6px">تحتاج إلى مساعدة؟ <a href="mailto:info@aisupport360.com" style="color:#2563EB;text-decoration:underline">info@aisupport360.com</a></p><p style="font-size:12px;line-height:1.55;color:#64748b;margin:0 0 6px">تصلك هذه الرسالة لأن أحد مسؤولي AI Support 360 أرسلها إليك في البوابة. <a href="https://www.aisupport360.com/notifications/pause" style="color:#2563EB;text-decoration:underline">إعدادات الإشعارات</a></p></div></div></body></html>"`;

exports[`organised messages — shared layout > e-mail HTML snapshot (EN, escaped admin text) 1`] = `"<html lang="en" dir="ltr"><head><meta charSet="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="color-scheme" content="light dark"/><meta name="supported-color-schemes" content="light dark"/></head><body style="margin:0;padding:24px 12px;background-color:#ffffff;font-family:Arial,Helvetica,sans-serif;color:#0f172a"><div style="display:none;max-height:0;overflow:hidden;opacity:0">Two quick changes and your profile can be verified.</div><div style="max-width:600px;width:100%;margin:0 auto;border:1px solid #e2e8f0;border-radius:16px;background-color:#ffffff;overflow:hidden;direction:ltr;text-align:left"><div style="padding:20px 24px;border-bottom:1px solid #e2e8f0;background-color:#ffffff"><img src="https://www.aisupport360.com/__l5e/assets-v1/94a9cd20-ec56-41c9-897e-534889a80659/brand-navy.png" width="180" height="40" alt="AI Support 360" style="display:block;border:0;width:180px;height:40px;max-width:100%"/></div><div style="padding:24px"><span style="display:inline-block;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:bold;letter-spacing:0.02em;color:#92400E;background-color:#FEF3C7">Request for action</span><h1 style="font-size:22px;line-height:1.3;color:#1B2559;margin:14px 0 6px">&lt;b&gt;Hi&lt;/b&gt; &amp; &quot;you&quot;</h1><p style="font-size:16px;line-height:1.5;color:#475569;margin:0 0 18px">Two quick changes and your profile can be verified.</p><p style="font-size:15px;line-height:1.65;color:#334155;margin:0 0 12px">Line &lt;script&gt;x&lt;/script&gt;</p><ul style="font-size:15px;line-height:1.6;color:#334155;margin:0 0 12px;padding-inline-start:22px"><li style="margin:0 0 4px"><strong>bold</strong> item</li></ul><div style="margin:18px 0;padding:14px 16px;border-radius:12px;background-color:#f8fafc;border:1px solid #e2e8f0"><p style="font-size:12px;color:#64748b;margin:0 0 4px;text-transform:uppercase;letter-spacing:0.04em">Ticket</p><p style="font-size:15px;font-weight:bold;color:#1B2559;margin:0">SAP FI posting error</p><p style="font-size:13px;color:#475569;margin:6px 0 0">#1A2B3C4D · Status: in progress</p></div><div style="margin:18px 0;padding:14px 16px;border-radius:12px;background-color:#FFFBEB;border:1px solid #FDE68A"><p style="font-size:13px;font-weight:bold;color:#92400E;margin:0 0 6px">What you need to do</p><p style="font-size:15px;color:#451A03;margin:0;line-height:1.5">Update your profile</p><p style="font-size:15px;color:#451A03;margin:0;line-height:1.5;margin-top:6px;font-weight:bold">Deadline: Fri, 6 Nov 2026</p></div><div style="margin:22px 0 10px"><a href="https://www.aisupport360.com/consultant/profile" style="display:inline-block;background-color:#1B2559;color:#ffffff;padding:14px 28px;border-radius:12px;font-size:16px;font-weight:bold;text-decoration:none">Reply in the portal</a></div><p style="font-size:14px;color:#2563EB;margin:0 0 18px"><a href="https://www.aisupport360.com/notifications" style="color:#2563EB;text-decoration:underline">View all notifications</a></p><p style="font-size:12px;color:#64748b;margin:18px 0 0;border-top:1px solid #e2e8f0;padding-top:14px">Sent by the AI Support 360 team (admin) · 30 Oct 2026, 12:40 UTC</p></div><div style="padding:16px 24px 22px;background-color:#f8fafc;border-top:1px solid #e2e8f0"><p style="font-size:12px;line-height:1.55;color:#64748b;margin:0 0 6px">To answer, open the portal with the button above. Replies to this e-mail are not read.</p><p style="font-size:12px;line-height:1.55;color:#64748b;margin:0 0 6px">Need help? <a href="mailto:info@aisupport360.com" style="color:#2563EB;text-decoration:underline">info@aisupport360.com</a></p><p style="font-size:12px;line-height:1.55;color:#64748b;margin:0 0 6px">You receive this because an AI Support 360 administrator sent you this message in the portal. <a href="https://www.aisupport360.com/notifications/pause" style="color:#2563EB;text-decoration:underline">Notification settings</a></p></div></div></body></html>"`;
