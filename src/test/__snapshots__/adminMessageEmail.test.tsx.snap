exports[`organised messages — shared layout > e-mail HTML snapshot (AR, right-to-left, digest) 1`] = `"<html lang="ar" dir="rtl"><head><meta charSet="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="color-scheme" content="light dark"/><meta name="supported-color-schemes" content="light dark"/><title>رسالة من فريق AI Support 360</title></head><body style="margin:0;padding:0;background-color:#ffffff;font-family:Arial,Helvetica,sans-serif;color:#0f172a;-webkit-text-size-adjust:100%"><div style="display:none;max-height:0;overflow:hidden;opacity:0;font-size:1px;line-height:1px">لديك 2 رسائل جديدة من الفريق</div><table role="presentation" cellPadding="0" cellSpacing="0" border="0" width="100%" bgcolor="#F1F4F9" style="background-color:#F1F4F9"><tbody><tr><td align="center" style="padding:28px 12px"><table role="presentation" cellPadding="0" cellSpacing="0" border="0" width="600" align="center" bgcolor="#ffffff" style="width:100%;max-width:600px;background-color:#ffffff;border:1px solid #E6EAF2;border-radius:18px;overflow:hidden;direction:rtl;text-align:right"><tbody><tr><td bgcolor="#072B5A" style="background-color:#072B5A;padding:22px 28px;border-radius:18px 18px 0 0;text-align:right"><img src="https://www.aisupport360.com/__l5e/assets-v1/94a9cd20-ec56-41c9-897e-534889a80659/brand-navy.png" width="160" height="36" alt="AI Support 360" style="display:inline-block;border:0;outline:none;width:160px;height:36px;max-width:100%"/></td></tr><tr><td bgcolor="#3B82F6" height="4" style="height:4px;font-size:0;line-height:0;background-color:#3B82F6;background-image:linear-gradient(270deg,#072B5A,#3B82F6)"> </td></tr><tr><td style="padding:30px 28px 6px;font-family:Arial,Helvetica,sans-serif"><h1 style="font-size:24px;line-height:32px;font-weight:bold;color:#1B2559;margin:16px 0 8px;margin-top:0">لديك 2 رسائل جديدة من الفريق</h1><div style="height:1px;line-height:1px;font-size:1px;background-color:#E6EAF2;margin:20px 0"> </div><div style="marg